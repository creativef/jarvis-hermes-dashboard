
# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
# Seconds of silence before a hung run is stopped (tool calls in flight are exempt).
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=1

# Offline voice (macOS `say`, used when no ElevenLabs key is set).
# Pick a voice with: say -v '?'   (e.g. Daniel, Samantha, Arthur, Serena)
# JARVIS_SAY_VOICE=Daniel

# Local voice (Kokoro TTS + Parakeet STT). Install with ./install-voice.sh
# JARVIS_KOKORO_VOICE=bm_george   # bm_george bm_daniel bm_fable bm_lewis (British m) · am_adam am_michael (US m) · bf_emma bf_isabella af_heart (f)
# JARVIS_KOKORO_SPEED=1.0
# JARVIS_LOCAL_VOICE=0            # set 0 to disable and use say/browser instead

# Backend. "auto" (default) keeps Hermes warm: the dashboard starts `hermes gateway run`
# with its API server on (unless one already answers at JARVIS_API_URL) and stops it on exit.
# Turns then skip the per-turn Hermes start-up, and flagged commands pause for your spoken
# or on-screen yes/no. Until it answers, turns use the one-shot CLI.
# Heads-up: a gateway also runs Hermes' cron jobs and any messaging bots you've configured.
#   auto | api (like auto, but notes every CLI fallback) | cli (never use the API server)
# JARVIS_BACKEND=auto
# JARVIS_START_GATEWAY=1          # 0 = never start a gateway; only use one that's running
# JARVIS_API_URL=http://127.0.0.1:8642
# JARVIS_API_KEY=                 # created for you on first launch (must match API_SERVER_KEY)
