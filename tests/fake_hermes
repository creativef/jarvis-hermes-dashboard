#!/usr/bin/env python3
"""Stand-in for the Hermes CLI, used only by the test suite.

Handles the three invocations the dashboard makes (`--version`, `tools list`,
`chat --format stream-json --query-file -`) and replays canned NDJSON so the
subprocess machinery is exercised without a live model. When FAKE_HERMES_LOG is
set, it appends a JSON record of argv + stdin so tests can assert what the
runtime actually invoked.
"""
import json
import os
import sys
import time


def _log(entry):
    path = os.environ.get("FAKE_HERMES_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry) + "\n")


def main(argv):
    if argv[:1] == ["--version"]:
        print("Hermes Agent v0.22.2 (fake)")
        return 0
    if argv[:2] == ["tools", "list"]:
        print("tool enabled: terminal")
        print("tool enabled: file")
        return 0
    if argv[:1] == ["chat"]:
        prompt = sys.stdin.read()
        _log({"argv": argv, "prompt": prompt})
        session_id = os.environ.get("FAKE_HERMES_SESSION", "20260101_000000_test00")
        stall = int(os.environ.get("FAKE_HERMES_STALL_MS", "0"))
        tool_stall = int(os.environ.get("FAKE_HERMES_TOOL_STALL_MS", "0"))

        def emit(obj):
            print(json.dumps(obj), flush=True)

        if stall:
            time.sleep(stall / 1000.0)  # silence before any output
        emit({"type": "system", "subtype": "init", "model": "fake", "session_id": session_id})
        emit({"type": "tool_use", "name": "terminal", "input": {"command": "echo hi"}})
        if tool_stall:
            time.sleep(tool_stall / 1000.0)  # stall while the tool "runs"
        emit({"type": "tool_result", "name": "terminal", "output": "hi", "is_error": False, "duration_ms": 5})
        emit({"type": "text", "text": "hello"})
        emit({"type": "result", "session_id": session_id, "exit_code": 0, "text": "hello",
              "tokens": {"input": 10, "output": 2, "total": 12, "cache_read": 0, "cache_write": 0}})
        return 0
    print("fake hermes: unknown args", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
