#!/usr/bin/env python3
"""Stand-in for the Hermes CLI, used only by the test suite.

Handles the three invocations the dashboard makes (`--version`, `tools list`,
`chat --format stream-json --query-file -`) and replays canned NDJSON so the
subprocess machinery is exercised without a live model. When FAKE_HERMES_LOG is
set, it appends a JSON record of argv + stdin so tests can assert what the
runtime actually invoked.
"""
import json
import os
import sys
import time


def _log(entry):
    path = os.environ.get("FAKE_HERMES_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry) + "\n")


def fake_gateway():
    """`hermes gateway run` with the API server on: /health, /v1/runs and its SSE events."""
    from http.server import BaseHTTPRequestHandler, HTTPServer
    if os.environ.get("API_SERVER_ENABLED") != "true":
        print("fake gateway: API server not enabled", file=sys.stderr)
        return 3
    key = os.environ.get("API_SERVER_KEY", "")

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body=b"", ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/health":
                return self._send(200, b'{"status": "ok"}')
            if self.headers.get("Authorization") != "Bearer " + key:
                return self._send(401)
            if self.path.endswith("/events"):
                frames = [{"event": "message.delta", "delta": "warm hello."},
                          {"event": "run.completed", "output": "warm hello.", "usage": {}}]
                body = "".join(f"data: {json.dumps(f)}\n\n" for f in frames).encode()
                return self._send(200, body, "text/event-stream")
            self._send(404)

        def do_POST(self):
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
            if self.headers.get("Authorization") != "Bearer " + key:
                return self._send(401)
            if self.path == "/v1/runs":
                _log({"gateway_run": body})
                return self._send(200, json.dumps({"run_id": "run_fake0001", "status": "started"}).encode())
            self._send(404)

    HTTPServer(("127.0.0.1", int(os.environ.get("API_SERVER_PORT", "8642"))), H).serve_forever()
    return 0


def main(argv):
    if argv[:1] == ["--version"]:
        print("Hermes Agent v0.22.2 (fake)")
        return 0
    if argv[:2] == ["tools", "list"]:
        print("tool enabled: terminal")
        print("tool enabled: file")
        return 0
    if argv[:2] == ["gateway", "run"]:
        return fake_gateway()
    if argv[:1] == ["chat"]:
        prompt = sys.stdin.read()
        _log({"argv": argv, "prompt": prompt})
        session_id = os.environ.get("FAKE_HERMES_SESSION", "20260101_000000_test00")
        stall = int(os.environ.get("FAKE_HERMES_STALL_MS", "0"))
        tool_stall = int(os.environ.get("FAKE_HERMES_TOOL_STALL_MS", "0"))

        def emit(obj):
            print(json.dumps(obj), flush=True)

        if stall:
            time.sleep(stall / 1000.0)  # silence before any output
        emit({"type": "system", "subtype": "init", "model": "fake", "session_id": session_id})
        emit({"type": "tool_use", "name": "terminal", "input": {"command": "echo hi"}})
        if tool_stall:
            time.sleep(tool_stall / 1000.0)  # stall while the tool "runs"
        emit({"type": "tool_result", "name": "terminal", "output": "hi", "is_error": False, "duration_ms": 5})
        emit({"type": "text", "text": "hello"})
        emit({"type": "result", "session_id": session_id, "exit_code": 0, "text": "hello",
              "tokens": {"input": 10, "output": 2, "total": 12, "cache_read": 0, "cache_write": 0}})
        exit_stall = int(os.environ.get("FAKE_HERMES_EXIT_STALL_MS", "0"))
        if exit_stall:
            time.sleep(exit_stall / 1000.0)  # slow shutdown after the answer (MCP, memory save)
        return 0
    print("fake hermes: unknown args", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
